# Repo path for code-graph and Headroom (--memory-project-root /workspace).
PROJECT_ROOT=/Users/you/work/repo/hyper-agent

# HuggingFace cache on the Mac host (read-only mount into headroom-ai).
# Must contain Qdrant/all-MiniLM-L6-v2-onnx for --memory. Default: ~/.cache/huggingface
# HF_CACHE=${HOME}/.cache/huggingface

# vLLM on the GPU host, reachable from this Mac. Default uses host.docker.internal
# (start SSH tunnel first: ssh -N -L 8000:127.0.0.1:8000 user@gpu-host).
# Or set a Tailscale/LAN address: http://100.x.x.x:8000
VLLM_UPSTREAM_URL=http://host.docker.internal:8000

# knowledge-rag-docs — host bind mounts for Docker (defaults under ./knowledge-rag-docs/)
# KNOWLEDGE_RAG_CONFIG=./knowledge-rag-docs/config.yaml
# KNOWLEDGE_RAG_DOCUMENTS=./knowledge-rag-docs/documents
# KNOWLEDGE_RAG_DATA=./knowledge-rag-docs/data

# Pull docs RAG bundle from GPU host (documents + Chroma index + models_cache):
# GPU_HOST=user@gpu-host
# REMOTE_DOCS_RAG_DIR=~/work/repo/hyper-agent/remote-gpu/knowledge-rag-docs
