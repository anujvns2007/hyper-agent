# Local environment (paths)
local/.env
remote-gpu/.env

# --- remote-gpu: public docs index ---
remote-gpu/knowledge-rag-docs/documents/*
!remote-gpu/knowledge-rag-docs/documents/.gitkeep
remote-gpu/knowledge-rag-docs/data/*
!remote-gpu/knowledge-rag-docs/data/.gitkeep

# --- local: code index + graph cache ---
local/knowledge-rag-code/data/*
!local/knowledge-rag-code/data/.gitkeep
local/code-graph-mcp/data/*
!local/code-graph-mcp/data/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
